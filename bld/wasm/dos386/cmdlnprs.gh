#ifndef OPT_STRING
#define OPT_STRING opt_string
typedef struct opt_string {
    struct opt_string *next;
    char data[1];
} opt_string;
#endif
#ifndef OPT_NUMBER
#define OPT_NUMBER opt_number
typedef struct opt_number {
    struct opt_number *next;
    unsigned number;
} opt_number;
#endif
typedef struct opt_storage OPT_STORAGE;
struct opt_storage {
    unsigned     timestamp;
    unsigned     w_value;
    unsigned     zcm_value;
    OPT_STRING   *nt_value;
    OPT_STRING   *nm_value;
    OPT_STRING   *nd_value;
    OPT_STRING   *nc_value;
    OPT_STRING   *i_value;
    OPT_STRING   *fr_value;
    OPT_STRING   *fo_value;
    OPT_STRING   *fl_value;
    OPT_STRING   *fi_value;
    OPT_STRING   *fe_value;
    unsigned     e_value;
    OPT_STRING   *d_value;
    OPT_STRING   *bt_value;
    unsigned     trace_stack;
    unsigned     mem_model;
    unsigned     fpu_type;
    unsigned     fpu_info;
    unsigned     debug_info;
    unsigned     ignore;
    unsigned     cpu_info;
    boolbit      wx : 1;
    boolbit      we : 1;
    boolbit      w : 1;
    boolbit      zzo : 1;
    boolbit      zz : 1;
    boolbit      zq : 1;
    boolbit      zld : 1;
    boolbit      zcm : 1;
    boolbit      od : 1;
    boolbit      o : 1;
    boolbit      nt : 1;
    boolbit      nm : 1;
    boolbit      nd : 1;
    boolbit      nc : 1;
    boolbit      j : 1;
    boolbit      i : 1;
    boolbit      fr : 1;
    boolbit      fo : 1;
    boolbit      fl : 1;
    boolbit      fi : 1;
    boolbit      fe : 1;
    boolbit      e : 1;
    boolbit      ee : 1;
    boolbit      d : 1;
    boolbit      cx : 1;
    boolbit      c : 1;
    boolbit      bt : 1;
    boolbit      _6p : 1;
    boolbit      _6s : 1;
    boolbit      _6r : 1;
    boolbit      _5p : 1;
    boolbit      _5s : 1;
    boolbit      _5r : 1;
    boolbit      _4p : 1;
    boolbit      _4s : 1;
    boolbit      _4r : 1;
    boolbit      _3p : 1;
    boolbit      _3s : 1;
    boolbit      _3r : 1;
    boolbit      _2p : 1;
    boolbit      _question : 1;
};
extern void OPT_INIT( OPT_STORAGE *data );
extern void OPT_FINI( OPT_STORAGE *data );
extern bool OPT_PROCESS( OPT_STORAGE *data );
