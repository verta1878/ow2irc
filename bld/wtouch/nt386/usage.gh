pick((MSG_USAGE_BASE+0), "Usage:   wtouch [<options>] <file_names>", "使用方法: wtouch [<ｵﾌﾟｼｮﾝ>] <ﾌｧｲﾙ名>")
pick((MSG_USAGE_BASE+1), " ", " ")
pick((MSG_USAGE_BASE+2), "Options: ('/' may be used instead of '-' to specify options)", "ｵﾌﾟｼｮﾝ: ('/'はオプション指定の際の'-'の替わりとして使用します)")
pick((MSG_USAGE_BASE+3), "-?        display this help screen", "-?        このヘルプ画面を表示します")
pick((MSG_USAGE_BASE+4), "-c        do not create files that do not exist", "-c        存在しないファイルは作成されません")
pick((MSG_USAGE_BASE+5), "-d <date> specify date part of the time-stamp explicitly", "-d <date> タイム・スタンプの日付部分を明示指定します")
pick((MSG_USAGE_BASE+6), "-f <file> use date-time from <file>", "-f <file> <ﾌｧｲﾙ>からの日付時間を使用します")
pick((MSG_USAGE_BASE+7), "-i        increment time stamp before touching <file_names>", "-i        <ﾌｧｲﾙ名>をタッチする前にタイムスタンプをインクリメントします")
pick((MSG_USAGE_BASE+8), "-q        suppress informational messages", "-q        情報メッセージを抑制します")
pick((MSG_USAGE_BASE+9), "-r        touch file even if it is marked read only", "-r        読み込み専用ファイルであっても、ﾀｲﾑｽﾀﾝﾌﾟを書き換えます。")
pick((MSG_USAGE_BASE+10), "-s        recurse through subdirectories", "-s        recurse through subdirectories")
pick((MSG_USAGE_BASE+11), "-t <time> specify time part of the time-stamp explicitly", "-t <time> タイム・スタンプの時間部分を明示指定します")
pick((MSG_USAGE_BASE+12), "-u        use USA date/time format regardless of country", "-u        USAの日付時間フォーマットを使用します")
