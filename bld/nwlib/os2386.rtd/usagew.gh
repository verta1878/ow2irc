pick((MSG_USAGE_WLIB_BASE+0), "Usage: wlib { <option> } <library_name> [ <commands> ]", "使用方法: wlib { <option> } <library_name> [ <commands> ]")
pick((MSG_USAGE_WLIB_BASE+1), "", "")
pick((MSG_USAGE_WLIB_BASE+2), "Where:", "各フィールドは以下の通りです:")
pick((MSG_USAGE_WLIB_BASE+3), "  <commands>  ::= <cmd> <commands>", "  <commands>  ::= <cmd> <commands>")
pick((MSG_USAGE_WLIB_BASE+4), "                | @<env_var> <commands>", "                | @<環境変数> <commands>")
pick((MSG_USAGE_WLIB_BASE+5), "                | @<cmd_file> <commands>", "                | @<cmd_file> <commands>")
pick((MSG_USAGE_WLIB_BASE+6), "  <cmd_file>  ::= file which contains { <cmd> }", "  <cmd_file>  ::= { <cmd> }を含むファイル")
pick((MSG_USAGE_WLIB_BASE+7), "", "")
pick((MSG_USAGE_WLIB_BASE+8), "  <cmd>       ::= +<object_file_name>                  (add file)", "  <cmd>       ::= +<オブジェクトファイル名>                   (ファイルの追加)")
pick((MSG_USAGE_WLIB_BASE+9), "                | +<library_file_name>.lib             (add library)", "                | +<ライブラリファイル名>.lib                 (ライブラリの追加)")
pick((MSG_USAGE_WLIB_BASE+10), "                | ++<symbol_name>.<DLL_name>[.<export_name>][.<ordinal>]", "                | ++<シンボル名>.<DLL名>[.<エクスポート名>][.<序数>]")
pick((MSG_USAGE_WLIB_BASE+11), "                | -<module_name>                       (delete)", "                | -<モジュール名>                          (削除)")
pick((MSG_USAGE_WLIB_BASE+12), "                | -+<object_file_name>                 (replace)", "                | -+<オブジェクトファイル名>                  (入れ替え)")
pick((MSG_USAGE_WLIB_BASE+13), "                | +-<object_file_name>                 (replace)", "                | +-<オブジェクトファイル名>                  (入れ替え)")
pick((MSG_USAGE_WLIB_BASE+14), "                | *<module_name>[=<object_file_name>]  (extract)", "                | *<モジュール名>[=<オブジェクトファイル名>]   (取り出し)")
pick((MSG_USAGE_WLIB_BASE+15), "                | -*<module_name>[=<object_file_name>] (extract and delete)", "                | -*<モジュール名>[=<オブジェクトファイル名>]  (取り出しと削除)")
pick((MSG_USAGE_WLIB_BASE+16), "                | *-<module_name>[=<object_file_name>] (extract and delete)", "                | *-<モジュール名>[=<オブジェクトファイル名>]  (取り出しと削除)")
pick((MSG_USAGE_WLIB_BASE+17), "", "")
pick((MSG_USAGE_WLIB_BASE+18), "The default filename extensions are lib, bak, lst, obj and lbc.", "デフォルトのファイル拡張子は、lib, bak, lst, obj, lbcです。")
pick((MSG_USAGE_WLIB_BASE+19), "Enclose a file name with quotes, i.e. 'filename', if it contains '-' or '@'.", "ﾌｧｲﾙ名に'-'や'@'が含まれるときは、'filename'のように引用符でﾌｧｲﾙ名を囲みます")
pick((MSG_USAGE_WLIB_BASE+20), "", "")
pick((MSG_USAGE_WLIB_BASE+21), "Options:", "オプション:")
pick((MSG_USAGE_WLIB_BASE+22), "          ( /option is also accepted )", "          ( /ｵﾌﾟｼｮﾝ でも指定できます )")
pick((MSG_USAGE_WLIB_BASE+23), "-?          display this screen", "-?          この画面を表示します")
pick((MSG_USAGE_WLIB_BASE+24), "-b          don't create .bak file", "-b           bakファイルを作成しません")
pick((MSG_USAGE_WLIB_BASE+25), "-c          case sensitive", "-c          大文字小文字を区別します")
pick((MSG_USAGE_WLIB_BASE+26), "-d=<path>   object output directory", "-d=<path>   オブジェクト出力ディレクトリ")
pick((MSG_USAGE_WLIB_BASE+27), "      Output Library format", "      出力ライブラリ形式")
pick((MSG_USAGE_WLIB_BASE+28), "-f{a,ab,ac,ag,m,o} ", "-f{a,ab,ac,ag,m,o} ")
pick((MSG_USAGE_WLIB_BASE+29), "  a         - output AR format library", "  a         - AR形式ﾗｲﾌﾞﾗﾘを出力します")
pick((MSG_USAGE_WLIB_BASE+30), "  ab        - output AR format (BSD) library", "  ab        - AR形式ﾗｲﾌﾞﾗﾘを出力します")
pick((MSG_USAGE_WLIB_BASE+31), "  ac        - output AR format (COFF) library", "  ac        - AR形式ﾗｲﾌﾞﾗﾘを出力します")
pick((MSG_USAGE_WLIB_BASE+32), "  ag        - output AR format (GNU) library", "  ag        - AR形式ﾗｲﾌﾞﾗﾘを出力します")
pick((MSG_USAGE_WLIB_BASE+33), "  m         - output MLIB format library", "  m         - MLIB形式ライブラリを出力します")
pick((MSG_USAGE_WLIB_BASE+34), "  o         - output OMF format library", "  o         - OMF形式ライブラリを出力します")
pick((MSG_USAGE_WLIB_BASE+35), "-in{n,o}    Non-resident table imports", "-in{n,o}    Non-resident table imports")
pick((MSG_USAGE_WLIB_BASE+36), "  n         - non-resident table symbols by name", "  n         - 非常駐テーブルシンボル (名前別)")
pick((MSG_USAGE_WLIB_BASE+37), "  o         - non-resident table symbols by ordinal", "  o         - 序数による非常駐テーブルシンボル")
pick((MSG_USAGE_WLIB_BASE+38), "-ir{n,o}    Resident table imports", "-ir{n,o}    Resident table imports")
pick((MSG_USAGE_WLIB_BASE+39), "  n         - resident table symbols by name", "  n         - 名前ごとの常駐テーブルシンボル")
pick((MSG_USAGE_WLIB_BASE+40), "  o         - resident table symbols by ordinal", "  o         - 序数による常駐テーブルシンボル")
pick((MSG_USAGE_WLIB_BASE+41), "-l[=<file>] list file name", "-l[=<file>] リストファイル名")
pick((MSG_USAGE_WLIB_BASE+42), "-m          display C++ mangled names", "-m          C++のマングルド名を表示します")
pick((MSG_USAGE_WLIB_BASE+43), "-n          always create a new library", "-n          常に新しいライブラリを作成します")
pick((MSG_USAGE_WLIB_BASE+44), "-o=<file>   output library file name", "-o=<file>   出力ライブラリファイル名")
pick((MSG_USAGE_WLIB_BASE+45), "-p=<num>    set OMF library page size", "-p=<num>    OMF ライブラリのページ サイズを設定する")
pick((MSG_USAGE_WLIB_BASE+46), "-pa         set OMF library optimal page size", "-pa         OMF ライブラリの最適なページ サイズを設定する")
pick((MSG_USAGE_WLIB_BASE+47), "-q          don't print header", "-q          起動メッセージを表示しません")
pick((MSG_USAGE_WLIB_BASE+48), "-s          strip line number debug info", "-s          strip line number debug info")
pick((MSG_USAGE_WLIB_BASE+49), "-t          trim THEADR pathnames", "-t          THEADR パス名を削除します")
pick((MSG_USAGE_WLIB_BASE+50), "-tl         internal terse listing", "-tl         internal terse listing")
pick((MSG_USAGE_WLIB_BASE+51), "-v          print header", "-v          print header")
pick((MSG_USAGE_WLIB_BASE+52), "-x[=<file>] explode all objects in library", "-x[=<file>] ライブラリからすべてのオブジェクトを取り出します")
pick((MSG_USAGE_WLIB_BASE+53), "-z[=<file>] strip exported symbols info", "-z[=<file>] strip exported symbols info")
pick((MSG_USAGE_WLIB_BASE+54), "-zld        strip file dependency info", "-zld        strip file dependency info")
