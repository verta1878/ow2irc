bool OPT_PROCESS_W( OPT_STORAGE_W *data )
{
    switch( OPT_GET_LOWER() ) {
    case 'i':
	switch( OPT_GET_LOWER() ) {
	case 'r':
	    if( OPT_RECOG_LOWER( 'n' ) ) {
		data->resident = OPT_ENUM_W_resident_irn;
		return( false );
	    }
	    if( OPT_RECOG_LOWER( 'o' ) ) {
		data->resident = OPT_ENUM_W_resident_iro;
		return( false );
	    }
	    return( true );
	case 'n':
	    if( OPT_RECOG_LOWER( 'n' ) ) {
		data->non_resident = OPT_ENUM_W_non_resident_inn;
		return( false );
	    }
	    if( OPT_RECOG_LOWER( 'o' ) ) {
		data->non_resident = OPT_ENUM_W_non_resident_ino;
		return( false );
	    }
	    return( true );
	case '6':
	    data->processor = OPT_ENUM_W_processor_i6;
	    return( false );
	case 'a':
	    data->processor = OPT_ENUM_W_processor_ia;
	    return( false );
	case 'c':
	    if( OPT_RECOG_LOWER( 'l' ) ) {
		data->filetype = OPT_ENUM_W_filetype_icl;
		return( false );
	    }
	    data->filetype = OPT_ENUM_W_filetype_ic;
	    return( false );
	case 'e':
	    data->filetype = OPT_ENUM_W_filetype_ie;
	    return( false );
	case 'i':
	    data->processor = OPT_ENUM_W_processor_ii;
	    return( false );
	case 'm':
	    data->processor = OPT_ENUM_W_processor_im;
	    return( false );
	case 'o':
	    data->filetype = OPT_ENUM_W_filetype_io;
	    return( false );
	case 'p':
	    data->processor = OPT_ENUM_W_processor_ip;
	    return( false );
	}
	OPT_UNGET();
	return( true );
    case 'f':
	if( OPT_RECOG_LOWER( 'a' ) ) {
	    if( OPT_RECOG_LOWER( 'b' ) ) {
		data->libformat = OPT_ENUM_W_libformat_fab;
		return( false );
	    }
	    if( OPT_RECOG_LOWER( 'c' ) ) {
		data->libformat = OPT_ENUM_W_libformat_fac;
		return( false );
	    }
	    if( OPT_RECOG_LOWER( 'g' ) ) {
		data->libformat = OPT_ENUM_W_libformat_fag;
		return( false );
	    }
	    data->libtype = OPT_ENUM_W_libtype_fa;
	    return( false );
	}
	if( OPT_RECOG_LOWER( 'm' ) ) {
	    data->libtype = OPT_ENUM_W_libtype_fm;
	    return( false );
	}
	if( OPT_RECOG_LOWER( 'o' ) ) {
	    data->libtype = OPT_ENUM_W_libtype_fo;
	    return( false );
	}
	return( true );
    case '?':
	data->_question = true;
	return( false );
    case 'h':
	data->_question = true;
	return( false );
    case 'b':
	data->b = true;
	return( false );
    case 'c':
	data->c = true;
	return( false );
    case 'd':
	if( OPT_GET_PATH( &(data->d_value) ) ) {
	    data->d = true;
	}
	return( false );
    case 'l':
	if( OPT_GET_FILE_OPT( &(data->l_value) ) ) {
	    data->l = true;
	}
	return( false );
    case 'm':
	data->m = true;
	return( false );
    case 'n':
	data->n = true;
	return( false );
    case 'o':
	if( OPT_GET_FILE( &(data->o_value) ) ) {
	    data->o = true;
	}
	return( false );
    case 'p':
	if( OPT_RECOG_LOWER( 'a' ) ) {
	    data->page_size = OPT_ENUM_W_page_size_pa;
	    return( false );
	}
	if( OPT_GET_NUMBER( &(data->p_value) ) ) {
	    data->page_size = OPT_ENUM_W_page_size_p;
	}
	return( false );
    case 'q':
	data->q_timestamp = ++(data->timestamp);
	data->q = true;
	return( false );
    case 's':
	data->s = true;
	return( false );
    case 't':
	if( OPT_RECOG_LOWER( 'l' ) ) {
	    data->tl = true;
	    return( false );
	}
	data->t = true;
	return( false );
    case 'v':
	data->v_timestamp = ++(data->timestamp);
	data->v = true;
	return( false );
    case 'x':
	if( OPT_GET_FILE_OPT( &(data->x_value) ) ) {
	    data->x = true;
	}
	return( false );
    case 'z':
	if( OPT_RECOG_LOWER( 'l' ) ) {
	    if( OPT_RECOG_LOWER( 'd' ) ) {
		data->zld = true;
		return( false );
	    }
	    if( OPT_RECOG_LOWER( 'l' ) ) {
		data->zll = true;
		return( false );
	    }
	    return( true );
	}
	if( OPT_GET_FILE_OPT( &(data->z_value) ) ) {
	    data->z = true;
	}
	return( false );
    }
    OPT_UNGET();
    return( true );
}
void OPT_INIT_W( OPT_STORAGE_W *data )
{
    memset( data, 0, sizeof( *data ) );
    data->page_size = OPT_ENUM_W_page_size_default;
    data->resident = OPT_ENUM_W_resident_default;
    data->non_resident = OPT_ENUM_W_non_resident_default;
    data->filetype = OPT_ENUM_W_filetype_default;
    data->processor = OPT_ENUM_W_processor_default;
    data->libformat = OPT_ENUM_W_libformat_default;
    data->libtype = OPT_ENUM_W_libtype_default;
}
void OPT_FINI_W( OPT_STORAGE_W *data )
{
    OPT_CLEAN_STRING( &(data->z_value) );
    OPT_CLEAN_STRING( &(data->x_value) );
    OPT_CLEAN_STRING( &(data->o_value) );
    OPT_CLEAN_STRING( &(data->l_value) );
    OPT_CLEAN_STRING( &(data->d_value) );
}
