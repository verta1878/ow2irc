bool OPT_PROCESS_A( OPT_STORAGE_A *data )
{
    switch( OPT_GET_LOWER() ) {
    case '?':
	data->_question = true;
	return( false );
    case 'h':
	data->_question = true;
	return( false );
    case 'c':
	data->c = true;
	return( false );
    case 'd':
	data->d = true;
	return( false );
    case 'r':
	data->r = true;
	return( false );
    case 't':
	data->t = true;
	return( false );
    case 'u':
	data->u = true;
	return( false );
    case 'v':
	data->v = true;
	return( false );
    case 'x':
	data->x = true;
	return( false );
    }
    OPT_UNGET();
    return( true );
}
void OPT_INIT_A( OPT_STORAGE_A *data )
{
    memset( data, 0, sizeof( *data ) );
}
void OPT_FINI_A( OPT_STORAGE_A *data )
{
    (void)data;
}
