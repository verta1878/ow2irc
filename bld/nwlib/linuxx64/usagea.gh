pick((MSG_USAGE_AR_BASE+0), "Usage: %s <options> <archive> [modules]", "使用法： %s <options> <archive> [modules]")
pick((MSG_USAGE_AR_BASE+1), "", "")
pick((MSG_USAGE_AR_BASE+2), "Options:", "オプション：")
pick((MSG_USAGE_AR_BASE+3), "-?       display this screen", "-?       この画面を表示します")
pick((MSG_USAGE_AR_BASE+4), "-c       suppress create archive message", "-c       アーカイブ作成メッセージを抑制する")
pick((MSG_USAGE_AR_BASE+5), "-d       delete modules from archive", "-d       アーカイブからモジュールを削除する")
pick((MSG_USAGE_AR_BASE+6), "-r       insert or replace modules", "-r       モジュールの挿入または交換")
pick((MSG_USAGE_AR_BASE+7), "-t       display modules or content", "-t       モジュールまたはコンテンツを表示する")
pick((MSG_USAGE_AR_BASE+8), "-u       update (only with -r command)", "-u       更新（-rコマンドのみ）")
pick((MSG_USAGE_AR_BASE+9), "-v       verbose output", "-v       詳細な出力")
pick((MSG_USAGE_AR_BASE+10), "-x       extract modules", "-x       モジュールを抽出する")
