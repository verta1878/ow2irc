pick((MSG_USAGE_BASE+0), "Usage: wasmips {options} {asm_files}", "Usage: wasmips {options} {asm_files}")
pick((MSG_USAGE_BASE+1), "Options:", "Options:")
pick((MSG_USAGE_BASE+2), "          ( /option is also accepted )", "          ( /optionも使用できます )")
pick((MSG_USAGE_BASE+3), "-?              print this message", "-?              print this message")
pick((MSG_USAGE_BASE+4), "-d<name>[=text] define text macro", "-d<name>[=text] define text macro")
pick((MSG_USAGE_BASE+5), "-e=<num>        set error limit number", "-e=<num>        set error limit number")
pick((MSG_USAGE_BASE+6), "-fo=<file>      set output filename (applies to the first asm_file)", "-fo=<file>      set output filename (applies to the first asm_file)")
pick((MSG_USAGE_BASE+7), "-i=<path>       set include path", "-i=<path>       set include path")
pick((MSG_USAGE_BASE+8), "-we             treat all warnings as errors", "-we             treat all warnings as errors")
pick((MSG_USAGE_BASE+9), "-zq             operate quietly", "-zq             operate quietly")
pick((MSG_USAGE_BASE+10), "        Output object file format", "        Output object file format")
pick((MSG_USAGE_BASE+11), "-oc COFF format", "-oc COFF format")
pick((MSG_USAGE_BASE+12), "-oe ELF format", "-oe ELF format")
