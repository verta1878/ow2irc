/*  100 */    50,    6,   57,   51,   13,   57,   51,   52,   53,    8,
/*  110 */    55,   53,   54,   54,   16,    8,   17,   53,   28,   53,
/*  120 */    53,   29,   53,   53,   30,   53,   53,   26,   53,   53,
/*  130 */    27,   53,   53,   24,   53,   53,   25,   53,   53,   23,
/*  140 */    53,   53,   21,   53,   53,   22,   53,   53,    2,   27,
/*  150 */    53,   26,   53,   32,   53,   16,   53,   17,    9,   18,
/*  160 */    58,   58,   18,   20,   20,    7,    4,   36,    0
};
static const char YYFAR * YYFAR yytoknames[] = {
"$eof",
"$impossible",
"error",
"T_FILE_SWITCH",
"T_DIRECTIVE",
"T_DIRECTIVE_OPERAND",
"T_OPCODE",
"T_IDENTIFIER",
"T_REGISTER",
"T_INTEGER_CONST",
"T_STRING_CONST",
"T_FLOAT_CONST",
"T_NEWLINE",
"T_COMMA",
"T_COLON",
"T_SEMICOLON",
"T_LEFT_PAREN",
"T_RIGHT_PAREN",
"T_RELOC_MODIFIER",
"T_NUMERIC_LABEL",
"T_NUMLABEL_REF",
"T_OR",
"T_XOR",
"T_AND",
"T_SHIFT_LEFT",
"T_SHIFT_RIGHT",
"T_PLUS",
"T_MINUS",
"T_TIMES",
"T_DIV",
"T_MOD",
"T_UNARY_MINUS",
"T_NOT",
"T_UNARY_PLUS",
"asm_file",
"asm_line",
"label",
"statement",
"directive",
"dir_name",
"dir_operands",
"dir_op_tail",
"dir_op",
"dir_ident",
"plus_minus_num_expr",
"num_expr_plus",
"num_expr",
"instruction",
"operand_list",
"operand_tail",
"operand",
"expression",
"reg_indirect",
"mem_reference",
"opcode",
"ins_operand",
"identifier",
"more_stmts",
"$start",
""
};
#endif


static YYSTYPE yyval;

YYSTYPE yylval;

#define yyerrok         yyerrflag = 0
#define yyclearin       yytoken = yyscan()

#ifndef MAXDEPTH
#define MAXDEPTH        100
#endif

#define YYABORT         return(true)
#define YYACCEPT        return(false)
#define YYERROR         goto yyerrlab

#ifdef YYDEBUG
static void dump_rule( unsigned rule )
{
    unsigned i;
    const YYTOKENTYPE YYFAR *yytoken;
    const char YYFAR *p;

  #if defined( _STANDALONE_ ) && defined( AS_DEBUG_DUMP )
    if( !_IsOption( DUMP_PARSE_TREE ) )
        return;
  #endif
    for( p = yytoknames[ yyplhstab[ rule ] ]; *p; ++p ) {
        putchar( *p );
    }
    putchar( ' ' );
    putchar( '<' );
    putchar( '-' );
    yytoken = &yyrhstoks[ yyrulebase[ rule ] ];
    for( i = yyplentab[rule]; i != 0; --i ) {
        putchar( ' ' );
        for( p = yytoknames[*yytoken]; *p; ++p ) {
            putchar( *p );
        }
        ++yytoken;
    }
    putchar( '\n' );
}
#endif

static YYACTTYPE find_action( YYACTTYPE yyk, YYTOKENTYPE yytoken )
{
    int     yyi;

    while( (yyi = yyk + yytoken) < 0 || yyi >= YYUSED || yychktab[yyi] != yytoken ) {
        if( (yyi = yyk + YYPARTOKEN) < 0 || yyi >= YYUSED || yychktab[yyi] != YYPARTOKEN ) {
            return( YYNOACTION );
        }
        yyk = yyacttab[yyi];
    }
    return( yyacttab[yyi] );
}

bool yyparse( void )
{
    short yypnum;
    short yyi;
    short yylhs;
    YYACTTYPE yyaction;
    YYTOKENTYPE yytoken;
    YYACTTYPE yys[MAXDEPTH], *yysp;
    YYSTYPE yyv[MAXDEPTH], *yyvp;
    short yyerrflag;

    yyerrflag = 0;
    yyaction = 0;
    yysp = yys;
    yyvp = yyv;
    *yysp = YYSTART;
    yytoken = yylex();
    for( ;; ) {
yynewact:
        yyaction = find_action( *yysp, yytoken );
        if( yyaction == YYNOACTION ) {
            yyaction = find_action( *yysp, YYDEFTOKEN );
            if( yyaction == YYNOACTION ) {
                switch( yyerrflag ) {
                case 0:
                    yyerror( "syntax error" );
                    YYERROR;
yyerrlab:
                case 1:
                case 2:
                    yyerrflag = 3;
                    while( yysp >= yys ) {
                        yyaction = find_action( *yysp, YYERRTOKEN );
                        if( yyaction != YYNOACTION && yyaction < YYUSED ) {
                            *++yysp = yyaction;
                            ++yyvp;
                            goto yynewact;
                        }
                        --yysp;
                        --yyvp;
                    }
                    YYABORT;
                case 3:
                    if( yytoken == YYEOFTOKEN )
                        YYABORT;
                    yytoken = yylex();
                    goto yynewact;
                }
            }
        }
        if( yyaction < YYUSED ) {
            if( yyaction == YYSTOP ) {
                YYACCEPT;
            }
            *++yysp = yyaction;
            *++yyvp = yylval;
            if( yyerrflag )
                --yyerrflag;
            yytoken = yylex();
        } else {
            yypnum = yyaction - YYUSED;
            yyi = yyplentab[yypnum];
            yysp -= yyi;
            yyvp -= yyi;
            yylhs = yyplhstab[yypnum];
            if( yysp < yys ) {
                printf( "stack underflow\n" );
                YYABORT;
            }
            yyaction = find_action( *yysp, yylhs );
            if( yyaction == YYNOACTION ) {
                printf( "missing nonterminal\n" );
                YYABORT;
            }
            *++yysp = yyaction;
            ++yyvp;
#ifdef YYDEBUG
            dump_rule( yypnum );
#endif
            switch( yypnum ) {
case 78:
/* expression <- T_INTEGER_CONST */
case 48:
/* num_expr <- T_INTEGER_CONST */
{ yyval.tree = ETConst( yyvp[0].val ); }
break;
case 77:
/* expression <- T_LEFT_PAREN expression T_RIGHT_PAREN */
case 47:
/* num_expr <- T_LEFT_PAREN num_expr T_RIGHT_PAREN */
{ yyval.tree = ETUnary( ET_PARENS, yyvp[1].tree ); }
break;
case 76:
/* expression <- T_NOT expression */
case 46:
/* num_expr <- T_NOT num_expr */
{ yyval.tree = ETUnary( ET_NOT, yyvp[1].tree ); }
break;
case 75:
/* expression <- T_PLUS expression */
case 45:
/* num_expr <- T_PLUS num_expr */
case 22:
/* plus_minus_num_expr <- T_PLUS num_expr */
{ yyval.tree = yyvp[1].tree; }
break;
case 74:
/* expression <- T_MINUS expression */
case 44:
/* num_expr <- T_MINUS num_expr */
case 23:
/* plus_minus_num_expr <- T_MINUS num_expr */
{ yyval.tree = ETUnary( ET_UNARY_MINUS, yyvp[1].tree ); }
break;
case 72:
/* expression <- expression T_XOR expression */
case 42:
/* num_expr <- num_expr T_XOR num_expr */
{ yyval.tree = ETBinary( ET_XOR, yyvp[0].tree, yyvp[2].tree ); }
break;
case 71:
/* expression <- expression T_OR expression */
case 41:
/* num_expr <- num_expr T_OR num_expr */
{ yyval.tree = ETBinary( ET_OR, yyvp[0].tree, yyvp[2].tree ); }
break;
case 70:
/* expression <- expression T_AND expression */
case 40:
/* num_expr <- num_expr T_AND num_expr */
{ yyval.tree = ETBinary( ET_AND, yyvp[0].tree, yyvp[2].tree ); }
break;
case 69:
/* expression <- expression T_SHIFT_RIGHT expression */
case 39:
/* num_expr <- num_expr T_SHIFT_RIGHT num_expr */
{ yyval.tree = ETBinary( ET_SHIFT_R, yyvp[0].tree, yyvp[2].tree ); }
break;
case 68:
/* expression <- expression T_SHIFT_LEFT expression */
case 38:
/* num_expr <- num_expr T_SHIFT_LEFT num_expr */
{ yyval.tree = ETBinary( ET_SHIFT_L, yyvp[0].tree, yyvp[2].tree ); }
break;
case 67:
/* expression <- expression T_MINUS expression */
case 37:
/* num_expr <- num_expr T_MINUS num_expr */
{ yyval.tree = ETBinary( ET_MINUS, yyvp[0].tree, yyvp[2].tree ); }
break;
case 66:
/* expression <- expression T_PLUS expression */
case 36:
/* num_expr <- num_expr T_PLUS num_expr */
{ yyval.tree = ETBinary( ET_PLUS, yyvp[0].tree, yyvp[2].tree ); }
break;
case 65:
/* expression <- expression T_MOD expression */
case 35:
/* num_expr <- num_expr T_MOD num_expr */
{ yyval.tree = ETBinary( ET_MOD, yyvp[0].tree, yyvp[2].tree ); }
break;
case 64:
/* expression <- expression T_DIV expression */
case 34:
/* num_expr <- num_expr T_DIV num_expr */
{ yyval.tree = ETBinary( ET_DIV, yyvp[0].tree, yyvp[2].tree ); }
break;
case 63:
/* expression <- expression T_TIMES expression */
case 33:
/* num_expr <- num_expr T_TIMES num_expr */
{ yyval.tree = ETBinary( ET_TIMES, yyvp[0].tree, yyvp[2].tree ); }
break;
case 55:
/* operand_tail <- T_COMMA ins_operand operand_tail */
case 54:
/* operand_tail <- */
case 53:
/* operand_list <- ins_operand operand_tail */
case 52:
/* operand_list <- */
case 30:
/* dir_op <- dir_ident */
case 18:
/* dir_op_tail <- T_COMMA dir_op dir_op_tail */
case 17:
/* dir_op_tail <- */
case 16:
/* dir_operands <- dir_op dir_op_tail */
case 15:
/* dir_operands <- */
case 12:
/* more_stmts <- T_SEMICOLON label statement more_stmts */
case 11:
/* more_stmts <- */
case 10:
/* statement <- instruction */
case 9:
/* statement <- directive */
case 8:
/* statement <- */
case 5:
/* label <- */
case 1:
/* asm_file <- asm_file asm_line */
case 0:
/* asm_file <- asm_line */
{ }
break;
case 21:
/* plus_minus_num_expr <- */
case 19:
/* num_expr_plus <- */
{ yyval.tree = ETConst( 0 ); }
break;
case 2:
/* asm_line <- label statement more_stmts T_NEWLINE */
{ CurrLineno++; }
break;
case 3:
/* asm_line <- error T_NEWLINE */
{ CurrLineno++; yyerrok; }
break;
case 4:
/* asm_line <- T_FILE_SWITCH */
{   /* #line directive */
                                                                    CurrLineno = yyvp[0].file->line;
                                                                    MemFree( CurrFilename );
                                                                    CurrFilename = MemStrdupSafe( yyvp[0].file->name );
                                                                    MemFree( yyvp[0].file );
                                                                }
break;
case 6:
/* label <- T_IDENTIFIER T_COLON label */
{ ObjEmitLabel( yyvp[0].sym ); }
break;
case 7:
/* label <- T_NUMERIC_LABEL label */
{ ObjEmitNumericLabel( yyvp[0].val ); }
break;
case 13:
/* directive <- dir_name dir_operands */
{
                                                                    bool okay;

                                                                    okay = DirParse( yyvp[0].dir );
                                                                    DirDestroy( yyvp[0].dir );
                                                                    AsCurrDir = NULL;
                                                                    if( !okay ) YYABORT;
                                                                }
break;
case 14:
/* dir_name <- T_DIRECTIVE */
{ yyval.dir = DirCreate( yyvp[0].sym ); AsCurrDir = yyval.dir; }
break;
case 20:
/* num_expr_plus <- num_expr T_PLUS */
{ yyval.tree = yyvp[0].tree; }
break;
case 24:
/* dir_ident <- num_expr_plus identifier plus_minus_num_expr */
{ DirAddOperand( AsCurrDir, DirOpIdentifier( ASM_RELOC_UNSPECIFIED, yyvp[1].sym, ETBinary( ET_PLUS, yyvp[0].tree, yyvp[2].tree ), 1 ) ); }
break;
case 25:
/* dir_ident <- num_expr_plus T_RELOC_MODIFIER identifier plus_minus_num_expr */
{ DirAddOperand( AsCurrDir, DirOpIdentifier( yyvp[1].rtype, yyvp[2].sym, ETBinary( ET_PLUS, yyvp[0].tree, yyvp[3].tree ), 1 ) ); }
break;
case 26:
/* dir_ident <- num_expr_plus T_NUMLABEL_REF plus_minus_num_expr */
{ DirAddOperand( AsCurrDir, DirOpNumLabelRef( ASM_RELOC_UNSPECIFIED, yyvp[1].val, ETBinary( ET_PLUS, yyvp[0].tree, yyvp[2].tree ), 1 ) ); }
break;
case 27:
/* dir_ident <- num_expr_plus T_RELOC_MODIFIER T_NUMLABEL_REF plus_minus_num_expr */
{ DirAddOperand( AsCurrDir, DirOpNumLabelRef( yyvp[1].rtype, yyvp[2].val, ETBinary( ET_PLUS, yyvp[0].tree, yyvp[3].tree ), 1 ) ); }
break;
case 28:
/* dir_op <- num_expr */
{ DirAddOperand( AsCurrDir, DirOpNumber( yyvp[0].tree ) ); }
break;
case 29:
/* dir_op <- T_DIRECTIVE_OPERAND */
{ DirAddOperand( AsCurrDir, DirOpLine( yyvp[0].str ) ); }
break;
case 31:
/* dir_op <- T_STRING_CONST */
{ DirAddOperand( AsCurrDir, DirOpString( yyvp[0].str ) ); }
break;
case 32:
/* dir_op <- num_expr T_COLON num_expr */
{ DirAddOperand( AsCurrDir, DirOpRepeat( yyvp[0].tree, yyvp[2].tree ) ); }
break;
case 43:
/* num_expr <- num_expr error */
{ /* Pass this on so that DirOpXXX will free the memory */ }
break;
case 49:
/* num_expr <- T_FLOAT_CONST */
{ yyval.tree = ETFPConst( yyvp[0].fval ); }
break;
case 50:
/* instruction <- opcode operand_list */
{ InsEmit( yyvp[0].ins ); InsDestroy( yyvp[0].ins ); AsCurrIns = NULL; }
break;
case 51:
/* opcode <- T_OPCODE */
{
                                                                    yyval.ins = InsCreate( yyvp[0].sym );
                                                                    if( AsCurrIns ) InsDestroy( AsCurrIns );
                                                                    AsCurrIns = yyval.ins;
                                                                }
break;
case 56:
/* ins_operand <- operand */
{ InsAddOperand( AsCurrIns, yyvp[0].op ); }
break;
case 57:
/* operand <- expression */
{ yyval.op = OpImmed( yyvp[0].tree ); }
break;
case 58:
/* operand <- T_REGISTER */
{ yyval.op = OpRegister( yyvp[0].reg ); }
break;
case 59:
/* operand <- mem_reference */
{ yyval.op = yyvp[0].op; }
break;
case 60:
/* mem_reference <- expression reg_indirect */
{ yyval.op = OpRegIndirect( yyvp[1].reg, yyvp[0].tree ); }
break;
case 61:
/* mem_reference <- reg_indirect */
{ yyval.op = OpRegIndirect( yyvp[0].reg, NULL ); }
break;
case 62:
/* reg_indirect <- T_LEFT_PAREN T_REGISTER T_RIGHT_PAREN */
{ yyval.reg = yyvp[1].reg; }
break;
case 73:
/* expression <- expression error */
{ /* Pass this on so that OpXXX will free the memory */ }
break;
case 79:
/* expression <- T_RELOC_MODIFIER identifier */
{ yyval.tree = ETReloc( yyvp[0].rtype, yyvp[1].sym ); }
break;
case 80:
/* expression <- identifier */
{ yyval.tree = ETReloc( ASM_RELOC_UNSPECIFIED, yyvp[0].sym ); }
break;
case 81:
/* expression <- T_RELOC_MODIFIER T_NUMLABEL_REF */
{ yyval.tree = ETNumLabelReloc( yyvp[0].rtype, yyvp[1].val ); }
break;
case 82:
/* expression <- T_NUMLABEL_REF */
{ yyval.tree = ETNumLabelReloc( ASM_RELOC_UNSPECIFIED, yyvp[0].val ); }
break;
case 83:
/* identifier <- T_IDENTIFIER */
{ yyval.sym = yyvp[0].sym; }
break;
case 84:
/* identifier <- T_DIRECTIVE */
{   if( !SymIsSectionSymbol( yyvp[0].sym ) ) {
                                                                        Error( INVALID_RELOC_SYM, SymName( yyvp[0].sym ) );
                                                                        YYERROR;
                                                                    }
                                                                    // otherwise
                                                                    yyval.sym = yyvp[0].sym;
                                                                }
break;

            default:
                yyval = yyvp[0];
            }
            *yyvp = yyval;
        }
    }
}
