#ifndef OPT_STRING
#define OPT_STRING opt_string
typedef struct opt_string {
    struct opt_string *next;
    char data[1];
} opt_string;
#endif
#ifndef OPT_NUMBER
#define OPT_NUMBER opt_number
typedef struct opt_number {
    struct opt_number *next;
    unsigned number;
} opt_number;
#endif
typedef struct opt_storage OPT_STORAGE;
struct opt_storage {
    unsigned     timestamp;
    unsigned     w_value;
    OPT_STRING   *i_value;
    OPT_STRING   *fr_value;
    OPT_STRING   *fo_value;
    unsigned     e_value;
    OPT_STRING   *d_value;
    OPT_STRING   *bt_value;
    unsigned     dump;
    unsigned     format;
    unsigned     debug;
    boolbit      zq : 1;
    boolbit      w : 1;
    boolbit      we : 1;
    boolbit      q : 1;
    boolbit      i : 1;
    boolbit      fr : 1;
    boolbit      fo : 1;
    boolbit      e : 1;
    boolbit      d : 1;
    boolbit      bt : 1;
    boolbit      _question : 1;
};
extern void OPT_INIT( OPT_STORAGE *data );
extern void OPT_FINI( OPT_STORAGE *data );
extern bool OPT_PROCESS( OPT_STORAGE *data );
#define OPT_ENUM_dump_vt 1
#define OPT_ENUM_dump_vs 2
#define OPT_ENUM_dump_vp 3
#define OPT_ENUM_dump_vl 4
#define OPT_ENUM_dump_vi 5
#define OPT_ENUM_dump_vd 6
#define OPT_ENUM_dump_default 7
#define OPT_ENUM_format_oe 8
#define OPT_ENUM_format_oc 9
#define OPT_ENUM_format_default 10
#define OPT_ENUM_debug_d3 11
#define OPT_ENUM_debug_d2 12
#define OPT_ENUM_debug_d1 13
#define OPT_ENUM_debug_d0 14
#define OPT_ENUM_debug_default 15
