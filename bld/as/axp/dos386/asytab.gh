#ifndef YYTOKENTYPE
#define T_FILE_SWITCH        0x03
#define T_DIRECTIVE          0x04
#define T_DIRECTIVE_OPERAND  0x05
#define T_OPCODE             0x06
#define T_IDENTIFIER         0x07
#define T_REGISTER           0x08
#define T_INTEGER_CONST      0x09
#define T_STRING_CONST       0x0a
#define T_FLOAT_CONST        0x0b
#define T_NEWLINE            0x0c
#define T_COMMA              0x0d
#define T_COLON              0x0e
#define T_SEMICOLON          0x0f
#define T_LEFT_PAREN         0x10
#define T_RIGHT_PAREN        0x11
#define T_RELOC_MODIFIER     0x12
#define T_NUMERIC_LABEL      0x13
#define T_NUMLABEL_REF       0x14
#define T_OR                 0x15
#define T_XOR                0x16
#define T_AND                0x17
#define T_SHIFT_LEFT         0x18
#define T_SHIFT_RIGHT        0x19
#define T_PLUS               0x1a
#define T_MINUS              0x1b
#define T_TIMES              0x1c
#define T_DIV                0x1d
#define T_MOD                0x1e
#define T_UNARY_MINUS        0x1f
#define T_NOT                0x20
#define T_UNARY_PLUS         0x21
typedef unsigned short yytokentype;
#define YYTOKENTYPE yytokentype
#endif
#ifndef YYSTYPE
typedef union {
    char            *str;
    void            *null;
    int_32          val;
    double          fval;
    sym_handle      sym;
    reg             reg;
    expr_tree       *tree;      /* node in an expression tree */
    instruction     *ins;
    ins_operand     *op;
    asm_reloc_type  rtype;
    directive_t     *dir;
    fileinfo        *file;
} yystype;
#define YYSTYPE yystype
#endif
