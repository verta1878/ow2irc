pick((MSG_USAGE_BASE+0), "Usage: wasppc {options} {asm_files}", "Usage: wasppc {options} {asm_files}")
pick((MSG_USAGE_BASE+1), "Options:", "Options:")
pick((MSG_USAGE_BASE+2), "-?              print this message", "-?              print this message")
pick((MSG_USAGE_BASE+3), "-d<name>[=text] define text macro", "-d<name>[=text] define text macro")
pick((MSG_USAGE_BASE+4), "-e=<num>        set error limit number", "-e=<num>        set error limit number")
pick((MSG_USAGE_BASE+5), "-fo=<file>      set output filename (applies to the first asm_file)", "-fo=<file>      set output filename (applies to the first asm_file)")
pick((MSG_USAGE_BASE+6), "-i=<path>       set include path", "-i=<path>       set include path")
pick((MSG_USAGE_BASE+7), "-we             treat all warnings as errors", "-we             treat all warnings as errors")
pick((MSG_USAGE_BASE+8), "-zq             operate quietly", "-zq             operate quietly")
pick((MSG_USAGE_BASE+9), "        Output object file format", "        Output object file format")
pick((MSG_USAGE_BASE+10), "-oc COFF format", "-oc COFF format")
pick((MSG_USAGE_BASE+11), "-oe ELF format", "-oe ELF format")
