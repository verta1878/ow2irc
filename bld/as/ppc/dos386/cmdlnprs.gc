bool OPT_PROCESS( OPT_STORAGE *data )
{
    switch( OPT_GET_LOWER() ) {
    case 'z':
	if( OPT_RECOG_LOWER( 'q' ) ) {
	    data->zq = true;
	    return( false );
	}
	return( true );
    case 'v':
	do {
	    switch( OPT_GET_LOWER() ) {
	    case 'd':
		data->dump = OPT_ENUM_dump_vd;
		continue;
	    case 'i':
		data->dump = OPT_ENUM_dump_vi;
		continue;
	    case 'l':
		data->dump = OPT_ENUM_dump_vl;
		continue;
	    case 'p':
		data->dump = OPT_ENUM_dump_vp;
		continue;
	    case 's':
		data->dump = OPT_ENUM_dump_vs;
		continue;
	    case 't':
		data->dump = OPT_ENUM_dump_vt;
		continue;
	    }
	    OPT_UNGET();
	    break;
	} while( ! OPT_END() );
	return( false );
    case 'o':
	if( OPT_RECOG_LOWER( 'c' ) ) {
	    data->format = OPT_ENUM_format_oc;
	    return( false );
	}
	if( OPT_RECOG_LOWER( 'e' ) ) {
	    data->format = OPT_ENUM_format_oe;
	    return( false );
	}
	return( true );
    case 'f':
	if( OPT_RECOG_LOWER( 'o' ) ) {
	    if( OPT_GET_FILE( &(data->fo_value) ) ) {
		data->fo = true;
	    }
	    return( false );
	}
	if( OPT_RECOG_LOWER( 'r' ) ) {
	    if( OPT_GET_FILE_OPT( &(data->fr_value) ) ) {
		data->fr = true;
	    }
	    return( false );
	}
	return( true );
    case 'b':
	if( OPT_RECOG_LOWER( 't' ) ) {
	    if( OPT_GET_ID_OPT( &(data->bt_value) ) ) {
		data->bt = true;
	    }
	    return( false );
	}
	return( true );
    case '?':
	data->_question = true;
	return( false );
    case 'h':
	data->_question = true;
	return( false );
    case 'd':
	switch( OPT_GET_LOWER() ) {
	case '0':
	    data->debug = OPT_ENUM_debug_d0;
	    return( false );
	case '1':
	    data->debug = OPT_ENUM_debug_d1;
	    return( false );
	case '2':
	    data->debug = OPT_ENUM_debug_d2;
	    return( false );
	case '3':
	    data->debug = OPT_ENUM_debug_d3;
	    return( false );
	}
	OPT_UNGET();
	if( scanDefine( &(data->d_value) ) ) {
	    data->d = true;
	}
	return( false );
    case 'e':
	if( OPT_GET_NUMBER( &(data->e_value) ) ) {
	    data->e = true;
	}
	return( false );
    case 'i':
	if( OPT_GET_PATH( &(data->i_value) ) ) {
	    data->i = true;
	}
	return( false );
    case 'q':
	data->q = true;
	return( false );
    case 'w':
	if( OPT_RECOG_LOWER( 'e' ) ) {
	    data->we = true;
	    return( false );
	}
	if( OPT_GET_NUMBER( &(data->w_value) ) ) {
	    data->w = true;
	}
	return( false );
    }
    OPT_UNGET();
    return( true );
}
void OPT_INIT( OPT_STORAGE *data )
{
    memset( data, 0, sizeof( *data ) );
    data->dump = OPT_ENUM_dump_default;
    data->format = OPT_ENUM_format_default;
    data->debug = OPT_ENUM_debug_default;
}
void OPT_FINI( OPT_STORAGE *data )
{
    OPT_CLEAN_STRING( &(data->i_value) );
    OPT_CLEAN_STRING( &(data->fr_value) );
    OPT_CLEAN_STRING( &(data->fo_value) );
    OPT_CLEAN_STRING( &(data->d_value) );
    OPT_CLEAN_STRING( &(data->bt_value) );
}
