#!/bin/bash
# owlink — OW2IRC linker wrapper
# Usage: owlink -bt=linux64 prog.o [prog2.o ...] -o prog
# Usage: owlink -bt=win64 prog.o [prog2.o ...] -o prog.exe
#
# the crew 4free

OWROOT="$(cd "$(dirname "$0")/../.." && pwd)"
MGWROOT="$OWROOT/bld/mingw64"

TARGET=""
OUTPUT=""
OBJECTS=""

while [ $# -gt 0 ]; do
  case "$1" in
    -bt=linux64) TARGET=linux64 ;;
    -bt=win64)   TARGET=win64 ;;
    -bt=win32)   TARGET=win32 ;;
    -o)          shift; OUTPUT="$1" ;;
    *)           OBJECTS="$OBJECTS $1" ;;
  esac
  shift
done

if [ -z "$TARGET" ]; then
  echo "Usage: owlink -bt=<target> file.o [...] -o output"
  echo "Targets: linux64, win64, win32"
  exit 1
fi

case "$TARGET" in
  linux64)
    CRT="$OWROOT/bld/clib/linux/x64/crt0_x64.o"
    if [ ! -f "$CRT" ]; then
      gcc -c "$OWROOT/bld/clib/linux/x64/crt0_x64.S" -o "$CRT"
    fi
    ld -o "$OUTPUT" "$CRT" $OBJECTS "$MGWROOT/build/libmingw64crt.a"
    ;;
  win64)
    x86_64-w64-mingw32-ld -o "$OUTPUT" $OBJECTS \
      -L"$MGWROOT/build/win64" -lmingw64win \
      -L"$MGWROOT/build/lib64-system" \
      -lkernel32 -lmsvcrt -luser32 -lgdi32
    ;;
  win32)
    echo "Win32 target: not yet implemented"
    exit 1
    ;;
esac
