pick((MSG_USAGE_BASE + 0), "", "使用方法:  wmake [options]* [macro=text]* [target]*")
pick((MSG_USAGE_BASE + 1), "", "オプション:  ( /optionも使用できます )")
pick((MSG_USAGE_BASE + 2), "", "-a 全ﾀｰｹﾞｯﾄを作成します(ﾀｲﾑ･ｽﾀﾝﾌﾟを無視)  -b すべての暗黙ﾙｰﾙを無視します")
pick((MSG_USAGE_BASE + 3), "", "-c 作られたﾌｧｲﾙがあるどうかﾁｪｯｸしません   -d ﾃﾞﾊﾞｯｸﾞ･ﾓｰﾄﾞ(処理過程を出力します)")
pick((MSG_USAGE_BASE + 4), "", "-e ｴﾗｰが起きた時、ﾌｧｲﾙを消します(確認しません)")
pick((MSG_USAGE_BASE + 5), "", "-f <filename>  MAKEFILEの代りにﾌｧｲﾙfilenameを処理します('-f -'は標準入力です)")
pick((MSG_USAGE_BASE + 6), "", "-h ﾌﾟﾛｸﾞﾗﾑ･ﾍｯﾀﾞを出力しません             -i ｺﾏﾝﾄﾞが返すｽﾃｰﾀｽを無視します")
pick((MSG_USAGE_BASE + 7), "", "-k ｴﾗｰが起きても続行します                -l <logfile>  ﾛｸﾞ･ﾌｧｲﾙに出力を追加します")
pick((MSG_USAGE_BASE + 8), "", "-m MAKEINIT ﾌｧｲﾙを読みません              -ms microsoft nmake mode")
pick((MSG_USAGE_BASE + 9), "", "-n 実行せずに、ｺﾏﾝﾄﾞを表示します          -o 循環ﾊﾟｽを利用します")
pick((MSG_USAGE_BASE + 10), "", "-p 依存規制、ﾏｸﾛの定義、拡張ｲﾝﾌｫﾒｰｼｮﾝなどを出力します")
pick((MSG_USAGE_BASE + 11), "", "-q 問い合せﾓｰﾄﾞ(ｺﾏﾝﾄﾞを実行しません)      -r ﾃﾞﾌｫﾙﾄ定義を無視します")
pick((MSG_USAGE_BASE + 12), "", "-s ｻｲﾚﾝﾄ･ﾓｰﾄﾞ(ｺﾏﾝﾄﾞを表示しません)        -sn Noisy mode (print all commands)")
pick((MSG_USAGE_BASE + 13), "", "-t ﾌｧｲﾙのﾀｲﾑ･ｽﾀﾝﾌﾟを更新します(ｺﾏﾝﾄﾞを実行しません)")
pick((MSG_USAGE_BASE + 14), "", "-u UNIX互換ﾓｰﾄ")
pick((MSG_USAGE_BASE + 15), "", "-v verbose listing of inline file         -y show why a target will be updated")
pick((MSG_USAGE_BASE + 16), "", "-z ﾌｧｲﾙを消しません(確認しません)")
pick((MSG_USAGE_BASE + 17), "", "macro=text    'macro' の値を 'text' で再定義します")
pick((MSG_USAGE_BASE + 18), "", "target        作成したいﾀｰｹﾞｯﾄを指定します(ﾃﾞﾌｫﾙﾄは一番目のﾀｰｹﾞｯﾄです)")
