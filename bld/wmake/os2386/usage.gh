pick((MSG_USAGE_BASE + 0), "Usage  :  wmake [options]* [macro=text]* [target]*", "")
pick((MSG_USAGE_BASE + 1), "Options:  ( /option is also accepted )", "")
pick((MSG_USAGE_BASE + 2), "-a make all targs (ignoring time stamp)  -b  block/ignore all implicit rules", "")
pick((MSG_USAGE_BASE + 3), "-c do not check existence of files made  -d  debug mode (echo progress of work)", "")
pick((MSG_USAGE_BASE + 4), "-e erase files after error (no prompt)", "")
pick((MSG_USAGE_BASE + 5), "-f <filename>  process filename instead of MAKEFILE ('-f -' means stdin)", "")
pick((MSG_USAGE_BASE + 6), "-h do not print program header           -i  ignore command return status", "")
pick((MSG_USAGE_BASE + 7), "-k continue after an error               -l <logfile>   output to logfile", "")
pick((MSG_USAGE_BASE + 8), "-m do not read MAKEINIT file             -ms Microsoft NMAKE mode", "")
pick((MSG_USAGE_BASE + 9), "-n print commands without executing      -o  take advantage of circular path", "")
pick((MSG_USAGE_BASE + 10), "-p print the dependency tree, macro definitions, and extension information", "")
pick((MSG_USAGE_BASE + 11), "-q query mode (commands not executed)    -r  ignore built-in definitions", "")
pick((MSG_USAGE_BASE + 12), "-s silent mode (do not print commands)   -sn noisy mode (print all commands)", "")
pick((MSG_USAGE_BASE + 13), "-t touch files (commands not executed)", "")
pick((MSG_USAGE_BASE + 14), "-u  UNIX compatibility mode", "")
pick((MSG_USAGE_BASE + 15), "-v verbose listing of inline files       -y  show why a target will be updated", "")
pick((MSG_USAGE_BASE + 16), "-z do not erase files (no prompt)", "")
pick((MSG_USAGE_BASE + 17), "macro=text      overrides the definition of 'macro' with the value 'text'", "")
pick((MSG_USAGE_BASE + 18), "target          specifies a target to make (default is first target)", "")
